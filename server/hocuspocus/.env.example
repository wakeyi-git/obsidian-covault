# CoVault 실시간 서버(Hocuspocus) 환경 변수 — 이 파일을 `.env`로 복사해 실제 값으로 채우세요.
#   cp .env.example .env
# .env는 .gitignore로 커밋에서 제외됩니다(시크릿 평문 노출 방지).
# 값 변경 후 적용: docker compose up -d --build

# (필수) HMAC 시크릿 — 플러그인의 ‘Yjs 공간 시크릿’(키체인 covault-yjs-secret)과 **동일**하게 두세요.
#   생성 예: openssl rand -hex 32
# ⚠ CHANGE_ME_로 시작하거나 16자 미만이면 서버가 기동을 거부합니다(알려진 시크릿 사용 방지).
YJS_SECRET=CHANGE_ME_replace-with-output-of-openssl-rand-hex-32

# (권장) CouchDB 연동 — 파일 단위 인가(rtpart) + 문서 시드/스냅샷(note)에 필요합니다.
# 비우면 공간 단위 인가 + SQLite 영속만 동작합니다.
COUCHDB_URL=http://NAS_IP:5984
# 전용 서비스 계정 권장(플러그인 ‘실시간 서버 계정’). admin도 동작하지만 유출 시 피해가 큽니다.
COUCHDB_USER=covault-rt
# 플러그인 ‘실시간 서버 계정’ 비밀번호(키체인 covault-rt-service-password)와 동일하게.
COUCHDB_PASSWORD=CHANGE_ME_service-account-password

# (선택) 스냅샷 디바운스(ms): 변경 후 이 시간 안에 묶어서 저장, MAX 안엔 반드시 저장.
# STORE_DEBOUNCE_MS=2000
# STORE_MAX_DEBOUNCE_MS=10000
