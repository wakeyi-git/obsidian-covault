{
	"name": "covault",
	"version": "0.126.11",
	"description": "운영자의 구성원별 폴더와 각 구성원 개인 vault를 CouchDB mirror DB로 양방향 동기화하고 공동 공간·실시간 공동 편집을 제공하는 Obsidian 플러그인(CoVault)",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"i18n:check": "node scripts/i18n-check.mjs",
		"version:check": "node scripts/check-version.mjs",
		"loc-check": "node scripts/loc-check.mjs",
		"lint": "eslint src"
	},
	"keywords": [
		"obsidian",
		"couchdb",
		"sync"
	],
	"author": "wakeyi",
	"license": "MIT",
	"dependencies": {
		"@hocuspocus/provider": "~4.1.1",
		"pouchdb-browser": "^9.0.0",
		"qrcode-generator": "^1.5.2",
		"y-codemirror.next": "^0.3.5",
		"y-excalidraw": "^2.0.12",
		"y-protocols": "^1.0.7",
		"yjs": "^13.6.31"
	},
	"devDependencies": {
		"@types/node": "^20.11.0",
		"@types/pouchdb-browser": "^6.1.5",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.20.0",
		"eslint": "^9.39.4",
		"events": "^3.3.0",
		"happy-dom": "^20.10.3",
		"obsidian": "1.11.4",
		"pouchdb-adapter-memory": "^9.0.0",
		"typescript": "^5.4.0",
		"typescript-eslint": "^8.61.0",
		"vitest": "^4.1.8"
	}
}
